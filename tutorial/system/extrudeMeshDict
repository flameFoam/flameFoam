FoamFile
{
    format      ascii;
    class       dictionary;
    object      extrudeMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

constructFrom    patch;
sourceCase       "$FOAM_CASE";

sourcePatches (front);
exposedPatchName back;

extrudeModel
{
    type            wedge;

    axisPt       (0 0.01 0);
    axis         (0 0 1);
    angle        2.5;
}

flipNormals false;
mergeFaces false;

