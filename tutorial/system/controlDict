FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "system";
    object          controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     foamRun;

solver          multicomponentFluid;

libs
(
  "flameFoam-13.0.0.so"
);

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         0.003;

deltaT          1e-05;

maxDeltaT       0.02;

writeControl    adjustableRunTime;

writeInterval   0.001;

purgeWrite      0;

writeFormat     binary;

writeCompression no;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

adjustTimeStep  yes;

maxCo           0.20;

functions
{
    #includeFunc    probes(funcName=pressure, p, points=((0.05 0.01 0.1)), writeControl=timeStep)
    #includeFunc    probes(funcName=temperature, T, points=((0.09 0.01 0.2) (0.09 0.01 0.4) (0.09 0.01 0.6) (0.09 0.01 0.8) (0.09 0.01 1.0)), writeControl=timeStep)
}

OptimisationSwitches
{
    fileHandler     collated;
    maxThreadFileBufferSize 2e+09;
    maxMasterFileBufferSize 2e+09;
}


