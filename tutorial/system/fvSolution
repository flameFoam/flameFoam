FoamFile
{
    format          ascii;
    class           dictionary;
    object          fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "(rhoFinal|rho)"
    {
        solver          diagonal; // tiesioginis sprendimas, nes lygtis solve(fvm::ddt(rho) + fvc::div(phi)) yra explicit
    }
    not_p
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-06;
        relTol          0.01;
        maxIter         50;
    }
    "(U|Yi|h|k|epsilon|omega)"
    {
        $not_p          ;
    }
    "(UFinal|YiFinal|hFinal|kFinal|epsilonFinal|omegaFinal)"
    {
        $not_p          ;
        tolerance       1e-07;
        relTol          0;
    }
    p_rgh
    {
        $not_p          ;
        tolerance       1e-05;
        relTol          0.01;
    }
    p_rghFinal
    {
        $p_rgh          ;
        relTol          0;
    }
    yPsi
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-6;
        relTol          0;
    }
    "(yPsiFinal)"
    {
        $yPsi           ;
        tolerance       1e-07;
        relTol          0;
    }
}

PIMPLE
{
    nOuterCorrectors 20;
    turbOnFinalIterOnly yes;
    momentumPredictor no;
    nCorrectors     1;
    nNonOrthogonalCorrectors 1;
    outerCorrectorResidualControl
    {
        all
        {
            relTol      0;
            tolerance   1e-5;
        }
        "(U|Yi|h|p_rgh|k|epsilon|omega|yPsi|yWall)"
        {
            $all        ;
        }
    }
}


